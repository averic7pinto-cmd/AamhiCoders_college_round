
{
  "manifest_version": 3,
  "name": "HANDSFREE",
  "version": "1.1.0",
  "description": "Accessible browser controls using hand gestures and head movements.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HANDSFREE",
    "default_popup": "popup.html"
  }
}
